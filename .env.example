# Provider-agnostic LLM config.
# Works for MiniMax (Anthropic-compatible), direct Anthropic, or any
# Anthropic-API-compatible proxy.

LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M2.7

# Max output tokens per reply
LLM_MAX_TOKENS=4096

# Optional system prompt (falls back to a default if empty)
LLM_SYSTEM_PROMPT=
