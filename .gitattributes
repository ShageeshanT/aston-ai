# Default to LF on checkin, native on checkout. Keeps Linux/macOS CI happy
# while still letting Windows tools see CRLF locally.
* text=auto eol=lf

# Force LF for code so cross-OS diffs stay sane.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf

# Binary fonts and images — never normalize.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
